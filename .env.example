# Postgres (with pgvector extension)
DATABASE_URL=postgresql+psycopg://edm:edm@127.0.0.1:5432/edm

# Provider selection
EDM_LLM_PROVIDER=gemini          # anthropic | gemini | stub
EDM_EMBEDDING_PROVIDER=voyage    # voyage | stub

# Anthropic — extraction + verification (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Google Gemini — extraction + verification (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Voyage — embeddings (optional)
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

# GitHub App / PAT for the PR-review bot
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem
GITHUB_WEBHOOK_SECRET=

# Target repo for demo-cut single-repo ingestion
TARGET_REPO=

# Server
EDM_HOST=127.0.0.1
EDM_PORT=8088
EDM_LOG_LEVEL=INFO
